<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Companion.Domain\Companion.Domain.csproj" />
    <ProjectReference Include="..\Companion.Application\Companion.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <!--
      Pinned above the version EF Core brings in (6.1.6 via EF 10.0.11, 6.1.7 via EF 10.0.14), which depend on
      System.Security.Cryptography.Pkcs 9.0.11 (GHSA-2fmv-rv2c-59x7 / GHSA-846f-f764-76mx).
      6.1.8 depends on the patched Pkcs 9.0.21. Remove once EF Core's SqlServer provider depends on >= 6.1.8.
    -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Creature compendium seed (spec 008), generated by scripts/import-creatures. -->
    <EmbeddedResource Include="Persistence\Seed\creatures.pocketdm.json" LogicalName="Companion.Infrastructure.Persistence.Seed.creatures.pocketdm.json" />
    <EmbeddedResource Include="Persistence\Seed\spells.magias5e.json" LogicalName="Companion.Infrastructure.Persistence.Seed.spells.magias5e.json" />
    <!-- Written by scripts/import-catalogs after the frozen translation (spec 011, T057). -->
    <EmbeddedResource Include="Persistence\Seed\items.srd52.json" LogicalName="Companion.Infrastructure.Persistence.Seed.items.srd52.json" Condition="Exists('Persistence\Seed\items.srd52.json')" />
  </ItemGroup>
</Project>
