      "expect": { "savingThrows.dex.bonus": 5, "savingThrows.dex.training": "Proficient", "savingThrows.str.bonus": 0 }
    },
    {
      "name": "perícia com proficiência e com especialização",
      "sheet": { "dexterity": 16, "level": 5, "skills": { "furtividade": "Expertise", "acrobacia": "Proficient" } },
      "expect": { "skills.furtividade.bonus": 9, "skills.acrobacia.bonus": 6, "skills.prestidigitacao.bonus": 3 }
    },
    {
      "name": "percepção passiva",
      "sheet": { "wisdom": 14, "skills": { "percepcao": "Proficient" } },
      "expect": { "passivePerception.value": 14 }
    },
