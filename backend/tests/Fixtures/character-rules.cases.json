{
  "$comment": "Spec 011, data-model.md (CharacterStats). Read by CharacterRulesTests. Each case: name, sheet (partial CharacterSheetData; missing fields use CharacterSheetData.Default), items (InventoryItemData JSON plus optional id and sortOrder; validated with .Validated()), spells (CharacterSpellData JSON), expect (dotted paths into the camelCase JSON of CharacterStats; a numeric segment indexes a list, 'length' counts it).",
  "cases": [
    { "name": "modificador no mínimo (FOR 1)", "sheet": { "strength": 1 }, "expect": { "abilities.str.final": 1, "abilities.str.modifier": -5 } },
    { "name": "modificador no máximo (FOR 30)", "sheet": { "strength": 30 }, "expect": { "abilities.str.modifier": 10 } },
    { "name": "modificadores com arredondamento para baixo", "sheet": { "dexterity": 15, "wisdom": 9, "intelligence": 8 }, "expect": { "abilities.dex.modifier": 2, "abilities.wis.modifier": -1, "abilities.int.modifier": -1 } },
    { "name": "proficiência no nível 4", "sheet": { "level": 4 }, "expect": { "proficiencyBonus": 2 } },
    { "name": "proficiência no nível 5", "sheet": { "level": 5 }, "expect": { "proficiencyBonus": 3 } },
    { "name": "proficiência no nível 8", "sheet": { "level": 8 }, "expect": { "proficiencyBonus": 3 } },
    { "name": "proficiência no nível 9", "sheet": { "level": 9 }, "expect": { "proficiencyBonus": 4 } },
    { "name": "proficiência no nível 12", "sheet": { "level": 12 }, "expect": { "proficiencyBonus": 4 } },
    { "name": "proficiência no nível 13", "sheet": { "level": 13 }, "expect": { "proficiencyBonus": 5 } },
    { "name": "proficiência no nível 16", "sheet": { "level": 16 }, "expect": { "proficiencyBonus": 5 } },
    { "name": "proficiência no nível 17", "sheet": { "level": 17 }, "expect": { "proficiencyBonus": 6 } },
