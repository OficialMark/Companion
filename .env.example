# Copie este arquivo para .env antes de iniciar.
# Use um segredo longo gerado aleatoriamente, por exemplo em hexadecimal.
# Alterar a variável após criar o volume não altera a senha no PostgreSQL.
POSTGRES_PASSWORD=Troque_Esta_Senha_2026!

# Segredo exclusivo para o painel oculto /admin. Não reutilize códigos de mesa.
ADMIN_ACCESS_KEY=Troque_Este_Segredo_Admin_2026!
