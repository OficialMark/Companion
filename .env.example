# Copie este arquivo para .env antes de iniciar.
# Use uma senha forte com letras maiúsculas, minúsculas, número e símbolo.
# Depois que o volume SQL for criado, não altere esta senha sem antes
# rotacionar o login sa; a variável não atualiza volumes existentes.
MSSQL_SA_PASSWORD=Troque_Esta_Senha_2026!

# Segredo exclusivo para o painel oculto /admin. Não reutilize códigos de mesa.
ADMIN_ACCESS_KEY=Troque_Este_Segredo_Admin_2026!
