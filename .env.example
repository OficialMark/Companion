# Copie este arquivo para .env apenas em uma instalação nova.
# Para migrar uma instalação PostgreSQL, siga docs/deploy-local-sqlite.md.
COMPANION_DATABASE_PROVIDER=Sqlite
COMPANION_DATABASE_CONNECTION='Data Source=/data/companion.db;Mode=ReadWriteCreate;Foreign Keys=True;Default Timeout=20'
COMPANION_POSTGRES_REPLICAS=0

# Segredo exclusivo para o painel oculto /admin. Não reutilize códigos de mesa.
ADMIN_ACCESS_KEY=Troque_Este_Segredo_Admin_2026!
